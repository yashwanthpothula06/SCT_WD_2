<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Modern Sky Blue Calculator with History</title>
    <!-- Google Fonts: Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Tailwind CSS for layout scaffolding -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <style>
        :root {
            --sky-light: #e0f2fe; /* Sky 100 */
            --sky-hover: #bae6fd; /* Sky 200 */
            --sky-main: #0ea5e9;  /* Sky 500 */
            --sky-dark: #0284c7;  /* Sky 600 */
            --bg-page: #f8fafc;   /* Slate 50 (Very light gray/white background) */
            --text-dark: #0f172a; /* Slate 900 */
            --text-muted: #64748b; /* Slate 500 */
            
            /* Glass properties adapted for high contrast light theme */
            --glass-bg: rgba(255, 255, 255, 0.75);
            --glass-border: rgba(14, 165, 233, 0.35); /* Sky blue border for absolute visibility */
            
            /* Button styling with deeper shadows for 3D depth and definition */
            --btn-bg: #ffffff;
            --btn-shadow: 0 5px 12px rgba(15, 23, 42, 0.08), 0 2px 4px rgba(14, 165, 233, 0.05);
            --btn-shadow-hover: 0 8px 16px rgba(14, 165, 233, 0.15), 0 2px 6px rgba(14, 165, 233, 0.08);
        }

        body {
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 1rem;
            min-height: 100vh;
            min-height: 100dvh; /* Dynamic viewport height to prevent mobile browser bar clipping */
            display: flex;
            justify-content: center;
            align-items: center;
            background: var(--bg-page);
            overflow-y: auto;
            overflow-x: hidden;
            color: var(--text-dark);
            position: relative;
            -webkit-user-select: none; /* Prevent accidental text highlighting while rapid tapping */
            user-select: none;
        }

        /* Soft, ambient glowing background lights */
        .bg-shape {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            z-index: 0;
            pointer-events: none;
        }
        .shape1 {
            width: 300px;
            height: 300px;
            background: rgba(56, 189, 248, 0.15);
            top: 15%;
            left: 10%;
        }
        .shape2 {
            width: 350px;
            height: 350px;
            background: rgba(14, 165, 233, 0.1);
            bottom: 10%;
            right: 10%;
        }

        /* Glassmorphism Calculator Container with prominent edges and shadows */
        .calculator {
            position: relative;
            z-index: 10;
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 2px solid var(--glass-border); /* 2px crisp border */
            border-radius: 32px;
            padding: 2rem;
            width: 100%;
            max-width: 380px;
            box-shadow: 0 25px 50px -12px rgba(14, 165, 233, 0.25), 
                        0 8px 24px rgba(15, 23, 42, 0.04),
                        inset 0 1px 0 rgba(255, 255, 255, 0.9);
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
            overflow: hidden; /* To mask the history overlay panel slide-up */
            touch-action: manipulation; /* Eliminate mobile tap-delay */
        }

        /* Screen Display Styling */
        .display {
            background: rgba(255, 255, 255, 0.8);
            border-radius: 20px;
            padding: 1.25rem;
            text-align: right;
            border: 1.5px solid var(--glass-border); /* Clear display borders */
            box-shadow: inset 0 2px 8px rgba(14, 165, 233, 0.08);
            min-height: 110px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            word-wrap: break-word;
            word-break: break-all;
        }

        .previous-operand {
            color: var(--text-muted);
            font-size: 0.9rem;
            font-weight: 400;
            min-height: 1.25rem;
        }

        .current-operand {
            color: var(--text-dark);
            font-size: 2.3rem;
            font-weight: 600;
            line-height: 1.2;
            letter-spacing: 0.5px;
            transition: font-size 0.2s;
        }
        
        .current-operand.error {
            color: #ef4444;
            font-size: 1.3rem;
        }

        /* Keypad Grid for 1:1 Aspect Ratio Round Buttons */
        .keypad {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
        }

        /* Perfect Circular Button Styles with emphasized borders and shadows */
        .btn {
            background: var(--btn-bg);
            /* 2px border combined with sky blue provides ultra-clear geometry for roundness */
            border: 2px solid rgba(14, 165, 233, 0.22); 
            border-radius: 50%; /* Perfect circle default */
            aspect-ratio: 1 / 1; /* Guarantees standard 1:1 round shape */
            color: var(--text-dark);
            font-size: 1.25rem;
            font-weight: 500;
            box-shadow: var(--btn-shadow);
            cursor: pointer;
            transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), 
                        background 0.2s ease, 
                        border-color 0.2s ease, 
                        box-shadow 0.2s ease, 
                        color 0.2s ease;
            display: flex;
            justify-content: center;
            align-items: center;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
            touch-action: manipulation;
        }

        /* Double spacing layout override for equals key */
        .span-2 {
            grid-column: span 2;
            aspect-ratio: auto !important; /* Cancel standard 1:1 aspect ratio */
            border-radius: 9999px !important; /* Smooth pill shape instead of circle */
        }

        /* Light, Elegant Desktop Hover Effects (Only active on pointer devices) */
        @media (hover: hover) {
            .btn:hover {
                background: var(--sky-light);
                border-color: rgba(56, 189, 248, 0.6);
                transform: translateY(-1.5px); /* Light and gentle hover lift */
                box-shadow: var(--btn-shadow-hover);
                color: var(--sky-dark);
            }
            .btn-operator:hover {
                background: var(--sky-main);
                color: white;
                border-color: var(--sky-main);
            }
            .btn-action:hover {
                background: #fee2e2; /* Red 100 */
                color: #dc2626;
                border-color: rgba(239, 68, 68, 0.3);
                box-shadow: 0 6px 15px rgba(239, 68, 68, 0.15);
            }
            .btn-equals:hover {
                background: linear-gradient(135deg, var(--sky-dark), #0369a1);
                color: white;
                box-shadow: 0 8px 22px rgba(14, 165, 233, 0.45);
            }
        }

        /* Tactical Mobile-First Tap Response (:active) */
        .btn:active {
            transform: scale(0.92) !important;
            background: var(--sky-hover);
            box-shadow: inset 0 2px 4px rgba(14, 165, 233, 0.15);
        }

        /* Button Variant Accents */
        .btn-operator {
            color: var(--sky-main);
            font-weight: 600;
        }
        
        .btn-operator:active {
            background: var(--sky-main) !important;
            color: white !important;
        }

        .btn-action {
            color: #ef4444; /* Soft Red for clear/backspace */
            font-weight: 600;
        }
        
        .btn-action:active {
            background: #fecaca !important; /* Red 200 */
            color: #dc2626 !important;
        }

        /* Custom operator styles for non-red actions */
        .btn-percentage {
            color: var(--sky-main);
            font-weight: 600;
        }

        /* Round Equals Key with Sky Blue Gradient */
        .btn-equals {
            background: linear-gradient(135deg, var(--sky-main), var(--sky-dark));
            color: white;
            border: none;
            font-weight: 600;
            box-shadow: 0 6px 15px rgba(14, 165, 233, 0.25);
        }

        .btn-equals:active {
            background: linear-gradient(135deg, var(--sky-dark), #0369a1) !important;
            color: white !important;
        }

        /* Sliding History Panel Styling as a BottomSheet */
        .history-panel {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 88%; /* High sheet style to provide lots of screen area for items and clear button on mobile */
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border-top: 2.5px solid var(--glass-border);
            border-radius: 32px 32px 0 0;
            z-index: 30;
            padding: 1.25rem;
            transform: translateY(100%);
            opacity: 0;
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            box-shadow: 0 -12px 35px rgba(14, 165, 233, 0.15);
        }

        .history-panel.open {
            transform: translateY(0);
            opacity: 1;
        }

        /* Pull-down gesture handle for mobile sheet vibe */
        .panel-handle {
            width: 45px;
            height: 5px;
            background: rgba(14, 165, 233, 0.25);
            border-radius: 99px;
            margin: -0.5rem auto 0.5rem auto;
            flex-shrink: 0;
        }

        .history-list {
            flex-grow: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 0.65rem;
            padding-right: 4px;
            -webkit-overflow-scrolling: touch; /* Smooth iOS momentum scrolling */
        }

        /* Scrollbar customization for History Log */
        .history-list::-webkit-scrollbar {
            width: 5px;
        }
        .history-list::-webkit-scrollbar-track {
            background: rgba(14, 165, 233, 0.05);
            border-radius: 10px;
        }
        .history-list::-webkit-scrollbar-thumb {
            background: rgba(14, 165, 233, 0.3);
            border-radius: 10px;
        }

        .history-item {
            background: rgba(14, 165, 233, 0.05);
            border: 1px solid rgba(14, 165, 233, 0.1);
            border-radius: 16px;
            padding: 0.75rem 1rem;
            text-align: right;
            cursor: pointer;
            transition: transform 0.15s ease, background 0.15s ease;
        }

        @media (hover: hover) {
            .history-item:hover {
                background: rgba(14, 165, 233, 0.12);
                border-color: rgba(14, 165, 233, 0.3);
                transform: scale(1.02);
            }
        }

        .history-item:active {
            transform: scale(0.97);
            background: rgba(14, 165, 233, 0.15);
        }

        /* Responsive Adjustments for Mobile Viewports */
        @media (max-width: 400px) {
            body {
                padding: 0.5rem;
            }
            .calculator {
                padding: 1.25rem;
                max-width: 100%;
                gap: 1rem;
                border-radius: 28px;
            }
            .keypad {
                gap: 10px;
            }
            .btn {
                font-size: 1.15rem;
                border-width: 2px; /* Maintain clear visibility on high resolution small viewports */
            }
            .current-operand {
                font-size: 2.1rem;
            }
            .history-panel {
                height: 90%; /* Let it cover slightly more area on smaller devices to keep viewport healthy */
                padding: 1.25rem 1rem;
            }
        }

        /* Special micro-screens check (e.g. folded foldables, small iPhone SE devices) */
        @media (max-width: 325px) {
            .calculator {
                padding: 1rem;
            }
            .keypad {
                gap: 8px;
            }
            .btn {
                font-size: 1rem;
            }
            .current-operand {
                font-size: 1.8rem;
            }
        }
    </style>
</head>
<body>

    <!-- Glowing light background accent fields -->
    <div class="bg-shape shape1"></div>
    <div class="bg-shape shape2"></div>

    <div class="calculator">
        <!-- Display Header and Screen Group -->
        <div class="flex flex-col gap-2">
            <!-- Header containing App Title and History Toggle Button -->
            <div class="flex items-center justify-between px-1 select-none">
                <div class="text-xs sm:text-sm font-bold tracking-widest text-sky-500 uppercase drop-shadow-sm">
                    Digital Calculator
                </div>
                <!-- History Toggle Icon Button (Optimized touch area with inline padding) -->
                <button id="history-toggle-btn" class="p-2 sm:p-2.5 rounded-full hover:bg-sky-100/60 active:bg-sky-200/80 text-sky-500 transition-colors duration-200" title="View History">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </button>
            </div>
            <!-- Calculator Display -->
            <div class="display">
                <div class="previous-operand" id="previous-operand"></div>
                <div class="current-operand" id="current-operand">0</div>
            </div>
        </div>

        <!-- Keypad configured to generate perfect circles with double-spaced equals key -->
        <div class="keypad">
            <!-- Row 1 -->
            <button class="btn btn-action" data-action="clear">C</button>
            <button class="btn btn-action" data-action="delete">⌫</button>
            <button class="btn btn-percentage" data-action="percent">%</button>
            <button class="btn btn-operator" data-operation="÷">÷</button>
            
            <!-- Row 2 -->
            <button class="btn" data-number="7">7</button>
            <button class="btn" data-number="8">8</button>
            <button class="btn" data-number="9">9</button>
            <button class="btn btn-operator" data-operation="×">×</button>
            
            <!-- Row 3 -->
            <button class="btn" data-number="4">4</button>
            <button class="btn" data-number="5">5</button>
            <button class="btn" data-number="6">6</button>
            <button class="btn btn-operator" data-operation="-">-</button>
            
            <!-- Row 4 -->
            <button class="btn" data-number="1">1</button>
            <button class="btn" data-number="2">2</button>
            <button class="btn" data-number="3">3</button>
            <button class="btn btn-operator" data-operation="+">+</button>
            
            <!-- Row 5 -->
            <button class="btn" data-number="0">0</button>
            <button class="btn" data-number=".">.</button>
            <button class="btn btn-equals span-2" data-action="calculate">=</button>
        </div>

        <!-- Sliding History Panel Inside the Card -->
        <div class="history-panel" id="history-panel">
            <!-- Pull sheet handle element -->
            <div class="panel-handle"></div>
            
            <div class="flex items-center justify-between border-b pb-2 border-slate-200">
                <h3 class="font-bold text-slate-800 text-sm sm:text-base">History</h3>
                <!-- Close Button (Padded touch targets for mobile) -->
                <button id="history-close-btn" class="p-2 -mr-2 rounded-full text-slate-400 hover:bg-slate-100 hover:text-slate-600 active:bg-slate-200 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 11-1.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>
            <!-- Dynamic History List -->
            <div class="history-list" id="history-list">
                <!-- Content injected dynamically via JavaScript -->
            </div>
            <!-- Clear History Action Container -->
            <div class="flex gap-2 mt-auto pt-2 border-t border-slate-200">
                <!-- Clear Button styled with beautiful premium sky-blue outline -->
                <button id="history-clear-btn" class="w-full py-2.5 sm:py-3 bg-sky-50 text-sky-600 active:bg-sky-100 text-xs sm:text-sm font-semibold rounded-2xl border border-sky-200 active:border-sky-300 transition-all text-center">
                    Clear History
                </button>
            </div>
        </div>
    </div>

    <script>
        class Calculator {
            constructor(previousOperandElement, currentOperandElement) {
                this.previousOperandElement = previousOperandElement;
                this.currentOperandElement = currentOperandElement;
                this.historyListElement = document.getElementById('history-list');
                this.history = JSON.parse(localStorage.getItem('calc_history')) || [];
                this.clear();
                this.updateHistoryUI();
            }

            clear() {
                this.currentOperand = '0';
                this.previousOperand = '';
                this.operation = undefined;
                this.errorState = false;
                this.shouldResetScreen = false;
            }

            delete() {
                if (this.errorState) {
                    this.clear();
                    return;
                }
                if (this.currentOperand === '0') return;
                
                this.currentOperand = this.currentOperand.toString().slice(0, -1);
                if (this.currentOperand === '' || this.currentOperand === '-') {
                    this.currentOperand = '0';
                }
            }

            appendNumber(number) {
                if (this.errorState) this.clear();
                if (this.shouldResetScreen) {
                    this.currentOperand = '';
                    this.shouldResetScreen = false;
                }
                
                // Avoid multiple decimal inputs
                if (number === '.' && this.currentOperand.includes('.')) return;
                
                if (this.currentOperand === '0' && number !== '.') {
                    this.currentOperand = number.toString();
                } else {
                    if (this.currentOperand.length < 15) {
                        this.currentOperand = this.currentOperand.toString() + number.toString();
                    }
                }
            }

            chooseOperation(operation) {
                if (this.errorState) this.clear();
                if (this.currentOperand === '' && this.previousOperand === '') return;
                
                if (this.currentOperand === '' && this.previousOperand !== '') {
                    this.operation = operation;
                    return;
                }

                if (this.previousOperand !== '') {
                    this.compute();
                }
                
                if(!this.errorState) {
                    this.operation = operation;
                    this.previousOperand = this.currentOperand;
                    this.currentOperand = '';
                }
            }

            computePercentage() {
                if (this.errorState || this.currentOperand === '') return;
                const current = parseFloat(this.currentOperand);
                if (isNaN(current)) return;
                
                const result = (current / 100).toString();
                this.saveToHistory(`${current}%`, result);
                this.currentOperand = result;
                this.shouldResetScreen = true;
            }

            compute() {
                if (this.errorState) return;
                let computation;
                const prev = parseFloat(this.previousOperand);
                const current = parseFloat(this.currentOperand);
                
                if (isNaN(prev) || isNaN(current)) return;

                switch (this.operation) {
                    case '+':
                        computation = prev + current;
                        break;
                    case '-':
                        computation = prev - current;
                        break;
                    case '×':
                        computation = prev * current;
                        break;
                    case '÷':
                        if (current === 0) {
                            this.handleError("Cannot divide by zero");
                            return;
                        }
                        computation = prev / current;
                        break;
                    default:
                        return;
                }

                // Precision check
                computation = Math.round(computation * 10000000000) / 10000000000;
                
                if (!isFinite(computation)) {
                    this.handleError("Result undefined");
                    return;
                }

                // Push calculation successfully computed to history
                const expression = `${this.getDisplayNumber(this.previousOperand)} ${this.operation} ${this.getDisplayNumber(this.currentOperand)}`;
                this.saveToHistory(expression, this.getDisplayNumber(computation));

                this.currentOperand = computation.toString();
                this.operation = undefined;
                this.previousOperand = '';
                this.shouldResetScreen = true;
            }

            handleError(msg) {
                this.currentOperand = msg;
                this.previousOperand = '';
                this.operation = undefined;
                this.errorState = true;
            }

            saveToHistory(expression, result) {
                const historyItem = { expression, result };
                this.history.unshift(historyItem); // Insert at beginning of log
                if (this.history.length > 50) this.history.pop(); // Limit history to 50 items
                localStorage.setItem('calc_history', JSON.stringify(this.history));
                this.updateHistoryUI();
            }

            clearHistory() {
                this.history = [];
                localStorage.removeItem('calc_history');
                this.updateHistoryUI();
            }

            updateHistoryUI() {
                if (this.history.length === 0) {
                    this.historyListElement.innerHTML = `
                        <div class="flex flex-col items-center justify-center h-full text-slate-400 gap-2 my-auto py-8">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <p class="text-xs">No calculations logged yet</p>
                        </div>
                    `;
                    return;
                }

                this.historyListElement.innerHTML = this.history.map((item, index) => `
                    <div class="history-item" data-index="${index}">
                        <div class="text-xs text-slate-500 overflow-hidden text-ellipsis whitespace-nowrap">${item.expression} =</div>
                        <div class="text-sm font-semibold text-sky-600 mt-0.5">${item.result}</div>
                    </div>
                `).join('');

                // Add item restoration clicks
                const items = this.historyListElement.querySelectorAll('.history-item');
                items.forEach(item => {
                    item.addEventListener('click', () => {
                        const idx = item.getAttribute('data-index');
                        const selectedResult = this.history[idx].result.replace(/,/g, ''); // strip formatting
                        
                        // Populate state with restored result
                        this.clear();
                        this.currentOperand = selectedResult;
                        this.updateDisplay();
                        
                        // Close history panel
                        document.getElementById('history-panel').classList.remove('open');
                    });
                });
            }

            getDisplayNumber(number) {
                if (this.errorState) return number;
                
                const stringNumber = number.toString();
                const integerDigits = parseFloat(stringNumber.split('.')[0]);
                const decimalDigits = stringNumber.split('.')[1];
                let integerDisplay;
                
                if (isNaN(integerDigits)) {
                    integerDisplay = '';
                } else {
                    integerDisplay = integerDigits.toLocaleString('en', {
                        maximumFractionDigits: 0
                    });
                }

                if (decimalDigits != null) {
                    return `${integerDisplay}.${decimalDigits}`;
                } else {
                    return integerDisplay;
                }
            }

            updateDisplay() {
                const currentEl = this.currentOperandElement;
                
                if (this.errorState) {
                    currentEl.innerText = this.currentOperand;
                    currentEl.classList.add('error');
                    this.previousOperandElement.innerText = '';
                } else {
                    currentEl.classList.remove('error');
                    
                    if (this.currentOperand.length > 10) {
                        currentEl.style.fontSize = '1.8rem';
                    } else if (this.currentOperand.length > 7) {
                        currentEl.style.fontSize = '2rem';
                    } else {
                        currentEl.style.fontSize = '2.5rem';
                    }

                    if (this.currentOperand === '0') {
                        currentEl.innerText = '0';
                    } else {
                        currentEl.innerText = this.getDisplayNumber(this.currentOperand);
                    }

                    if (this.operation != null) {
                        this.previousOperandElement.innerText = 
                            `${this.getDisplayNumber(this.previousOperand)} ${this.operation}`;
                    } else {
                        this.previousOperandElement.innerText = '';
                    }
                }
            }
        }

        // Initialize elements
        const previousOperandTextElement = document.getElementById('previous-operand');
        const currentOperandTextElement = document.getElementById('current-operand');
        const calculator = new Calculator(previousOperandTextElement, currentOperandTextElement);

        const numberButtons = document.querySelectorAll('[data-number]');
        const operationButtons = document.querySelectorAll('[data-operation]');
        const equalsButton = document.querySelector('[data-action="calculate"]');
        const deleteButton = document.querySelector('[data-action="delete"]');
        const clearButton = document.querySelector('[data-action="clear"]');
        const percentButton = document.querySelector('[data-action="percent"]');

        // History panel DOM elements
        const historyPanel = document.getElementById('history-panel');
        const historyToggleBtn = document.getElementById('history-toggle-btn');
        const historyCloseBtn = document.getElementById('history-close-btn');
        const historyClearBtn = document.getElementById('history-clear-btn');

        // Toggle History panel
        historyToggleBtn.addEventListener('click', () => {
            historyPanel.classList.add('open');
        });

        historyCloseBtn.addEventListener('click', () => {
            historyPanel.classList.remove('open');
        });

        historyClearBtn.addEventListener('click', () => {
            calculator.clearHistory();
        });

        // Click visual feedback simulation
        const triggerButtonFeedback = (btnElement) => {
            if(!btnElement) return;
            btnElement.style.transform = 'translateY(1px) scale(0.96)';
            btnElement.style.boxShadow = '0 2px 5px rgba(15, 23, 42, 0.05)';
            setTimeout(() => {
                btnElement.style.transform = '';
                btnElement.style.boxShadow = '';
            }, 100);
        };

        // Click Event Handlers
        numberButtons.forEach(button => {
            button.addEventListener('click', () => {
                calculator.appendNumber(button.innerText);
                calculator.updateDisplay();
            });
        });

        operationButtons.forEach(button => {
            button.addEventListener('click', () => {
                calculator.chooseOperation(button.innerText);
                calculator.updateDisplay();
            });
        });

        equalsButton.addEventListener('click', () => {
            calculator.compute();
            calculator.updateDisplay();
        });

        clearButton.addEventListener('click', () => {
            calculator.clear();
            calculator.updateDisplay();
        });

        deleteButton.addEventListener('click', () => {
            calculator.delete();
            calculator.updateDisplay();
        });

        percentButton.addEventListener('click', () => {
            calculator.computePercentage();
            calculator.updateDisplay();
        });

        // Keyboard mapping
        document.addEventListener('keydown', (e) => {
            if (['Enter', 'Backspace', 'Escape', ' '].includes(e.key)) {
                if(e.key === ' ' && e.target === document.body) e.preventDefault();
            }

            if (/[0-9\.]/.test(e.key)) {
                calculator.appendNumber(e.key);
                const btn = Array.from(numberButtons).find(b => b.innerText === e.key);
                triggerButtonFeedback(btn);
            }
            if (e.key === '+' || e.key === '-') {
                calculator.chooseOperation(e.key);
                const btn = Array.from(operationButtons).find(b => b.dataset.operation === e.key);
                triggerButtonFeedback(btn);
            }
            if (e.key === '*' || e.key === 'x') {
                calculator.chooseOperation('×');
                const btn = Array.from(operationButtons).find(b => b.dataset.operation === '×');
                triggerButtonFeedback(btn);
            }
            if (e.key === '/') {
                e.preventDefault();
                calculator.chooseOperation('÷');
                const btn = Array.from(operationButtons).find(b => b.dataset.operation === '÷');
                triggerButtonFeedback(btn);
            }
            if (e.key === 'Enter' || e.key === '=') {
                e.preventDefault();
                calculator.compute();
                triggerButtonFeedback(equalsButton);
            }
            if (e.key === 'Backspace') {
                calculator.delete();
                triggerButtonFeedback(deleteButton);
            }
            if (e.key === 'Escape') {
                calculator.clear();
                triggerButtonFeedback(clearButton);
            }
            
            calculator.updateDisplay();
        });

        calculator.updateDisplay();
    </script>
</body>
</html>
